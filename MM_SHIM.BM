' MM_SHIM.BM -- InForm replacements for the dialog / screen helpers of the old program.
' Included AFTER InForm.bi and the form.

' ---------------------------------------------------------------------------------
'  Dialogs.  The old program drew its own dialog boxes, now InForm's MessageBox does it.
' ---------------------------------------------------------------------------------
Function MM_Msg$ (S$)
    Dim T$, P As Long
    T$ = S$
    Do
        P = InStr(T$, CRLF)
        If P = 0 Then Exit Do
        T$ = Left$(T$, P - 1) + "\n" + Mid$(T$, P + 2)
    Loop
    MM_Msg = T$
End Function

' does the installed ffmpeg have the libwebp encoder ?
Function MM_HasLibwebp%
    Dim T$, F$, D$, R$, fn As Integer
    D$ = Environ$("TEMP")
    If D$ = "" Then D$ = Environ$("TMPDIR")
    If D$ = "" Then D$ = "/tmp"
    If Right$(D$, 1) <> "/" And Right$(D$, 1) <> "\" Then D$ = D$ + Slash$
    F$ = D$ + "mm_encoders.txt"
    If _FileExists(F$) Then Kill F$
    Shell _Hide "ffmpeg -hide_banner -encoders > " + Chr$(34) + F$ + Chr$(34) + " 2>&1"
    MM_HasLibwebp = _FALSE
    If _FileExists(F$) Then
        R$ = _ReadFile$(F$)
        Kill F$
        If InStr(R$, "libwebp") > 0 Then MM_HasLibwebp = _TRUE
    End If
End Function

Function GotYES (Title$, Mesg$, DEFVAL%)
    Dim flags As Long, R As Long
    flags = MsgBox_YesNo + MsgBox_Question
    If Not DEFVAL% Then flags = flags + MsgBox_DefaultButton2
    R = MessageBox(MM_Msg$(Mesg$), _Trim$(Title$), flags)
    GotYES = (R = MsgBox_Yes)
End Function

Sub INFO_DIALOG (Title$, Mesg$, btype$)
    Dim flags As Long
    Select Case LCase$(_Trim$(btype$))
        Case "error": flags = MsgBox_Critical
        Case "warning": flags = MsgBox_Exclamation
        Case Else: flags = MsgBox_Information
    End Select
    MessageBox MM_Msg$(Mesg$), _Trim$(Title$), MsgBox_OkOnly + flags
End Sub

' Free text prompts are now fields on the main form, this only remains as a safety net
Function INPUT_DIALOG$ (Title$, Mesg$, DEFVAL$, MaxLength As Integer, DIGITS_ONLY As Integer)
    INPUT_DIALOG = DEFVAL$
End Function

Function I_WantToQuit
    I_WantToQuit = GotYES("QUIT ?", "Do you really want to quit ?", _FALSE)
End Function

Function I_WantToQuit_CRITICAL
    I_WantToQuit_CRITICAL = GotYES("QUIT ?", "A conversion is in progress !" + CRLF + CRLF + "Do you really want to quit ?", _FALSE)
End Function


' The old program quit here (after a cancelled or failed run).  Now it returns to the setup form.
Sub EXIT_MOVIEMAKER
    MM_ABORTED = _TRUE
    MM_Relaunch
End Sub

Sub MM_Nop
End Sub

' "the screen" of the old program: the conversion preview while it is shown, else the text screen
Sub MM_DestScr
    If MM_PREVIEW_ON And (MM_PREVIEW_IMG < -1) Then
        _Dest MM_PREVIEW_IMG
    Else
        _Dest MM_SCR
    End If
End Sub

