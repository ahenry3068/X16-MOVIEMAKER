Function COMMODORE_FRIENDLY_NAME$ (OLDNAME$)
    Dim TMP$
    Dim TMPS$
    Dim LSTR$
    Dim RSTR$
    Dim C As String * 1
    Dim A As Integer
    Dim I As Long
    TMPS$ = UCase$(OLDNAME$)
    If FOR_VGA Then
        TMP$ = _Trim$(Left$(GetFileName(OLDNAME$), 8))
        TMP$ = TMP$ + GetFileExt(OLDNAME$)
        GoTo FDONE
    End If
    For I = 1 To Len(TMPS$)
        C = Mid$(TMPS$, I, 1)
        If C = "_" Then C = "-"
        If C = "?" Or C = "*" Or C = "|" Then _Continue
        A = Asc(C)
        If A > 31 And A < 128 Then
            TMP$ = TMP$ + C
        End If
        If Len(TMP$) > 17 And InStr(TMP$, ".") = 0 Then
            While Len(TMP$) > 0 _AndAlso Right$(TMP$, 1) = Chr$(32)
                TMP$ = Left$(TMP$, Len(TMP$) - 1)
            Wend
            If Len(TMP$) > 12 Then
                TMP$ = TMP$ + GetFileExt(TMPS$)
                Exit For
            End If
        End If
    Next
    FDONE:
    If FOR_VGA Then
        Do
            I = InStr(TMP$, Chr$(32))
            If I > 0 Then
                Mid$(TMP$, I, 1) = "-"
            End If
        Loop Until I = 0
    End If
    COMMODORE_FRIENDLY_NAME$ = TMP$
End Function

Function FILE_LENGTH~&& (FNAME$)
    Dim TMP~&&
    Dim TLFN As Long
    If _FileExists(FNAME$) Then
        TLFN = FreeFile
        Open FNAME$ For Binary As TLFN
        TMP~&& = LOF(TLFN)
        Close TLFN
    Else
        TMP~&& = 0
    End If
    FILE_LENGTH = TMP~&&
End Function

Sub COUT (S$)
    Dim H As Long
    H = _Dest
    _Dest _Console
    Print S$
    _Dest H
End Sub


' Error handler for SAFE_KILL (QB64 wants the handler label at module level).
' This file is included after InForm's main loop, so this code is only ever reached by an error.
KILLFAILED:
SAFEKILL_FAILED = _TRUE
Resume Next
