        If J = 1 Then
            X = _MessageBox("Attempt Download of source #1", "Do You want to download from " + CRLF + "ImageMagick.ORG", "yesno", "question", 0)
            If X = 1 Then Shell ("start  https://imagemagick.org/archive/binaries/ImageMagick-7.1.1-47-Q8-x64-static.exe")
            If X = 1 Then GoTo FinishMInstall
        End If

        If J = 1 Then
            X = _MessageBox("Attempt Direct Download Source 2 ", "Do You want to download ImageMagick Version 6" + CRLF + "(Cached on the X16 Forum)", "yesno", "question", 0)
            If X = 1 Then Shell ("start  https://cx16forum.com/forum/download/file.php?id=2469")
            GoTo FinishMInstall
        End If
        DONEWINDOWS:
    $End If

    $If LINUX Then
        If IsInstalled("apt") Then
            X = _MessageBox("Install with apt", "Attempt ImageMagick install with apt ?" + CRLF + "(Must have a visible console Window)", "yesno", "question", 0)
            If X = 1 Then
                Shell ("apt install imagemagick -y")
                GoTo FinishMInstall
            End If
        End If
        If IsInstalled("yum") Then
            X = _MessageBox("Install with Yum", "Attempt ImageMagick install with Yum ?" + CRLF + "(Must have a visible console Window)", "yesno", "question", 0)
            If X = 1 Then
                Shell ("yum install imagemagick")
                GoTo FinishMInstall
            End If
        End If
        If IsInstalled("brew") Then
            X = _MessageBox("Install with Brew", "Attempt ImageMagick install with HomeBrew ?" + CRLF + "(Must have a visible console Window)", "yesno", "question", 0)
            If X = 1 Then
                Shell ("brew install imagemagick")
                GoTo FinishMInstall
            End If
        End If
    $End If

    $If MAC Then
        If IsInstalled("brew") Then
            X = _MessageBox("Install with Brew", "Attempt ImageMagick install with HomeBrew ?" + CRLF + "(Must have a visible console Window)", "yesno", "question", 0)
            If X = 1 Then
                Shell ("brew install imagemagick")
                GoTo FinishMInstall
            End If
        End If
    $End If

    FinishMInstall:
    X = _MessageBox("X16 Movie Maker ", "Continue Opening X16 Movie Maker ? " + CRLF + "(If you have installed the ImageMagick package.)", "yesno", "question", 0)
    If X <> 1 Then System
    $If WINDOWS Then
        MM_Nop
    $End If
End Sub

Sub DualPrint (Text$)
    MM_DestScr
    Print Text$
    _Dest _Console
