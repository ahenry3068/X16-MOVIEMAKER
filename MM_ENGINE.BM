' MM_ENGINE.BM -- the converter engine of X16 Movie Maker (frame loading, dithering,
' audio, SPV writing).  Taken from MakeX16Movie.bas with the old menus and screens removed.
Sub Write_VIDEO_HEADER (NumberOfFrames As Long, BLANK_FIRST_AUDIO As Integer)
    Dim I As Long

    VideoHeader.NumFrames = NumberOfFrames

    Put MainLFN, , VideoHeader

    If MAKE_SECTOR_VIDEO Then
        PAD_VIDEO_HEADER
        If DoPadFrame Then
            ReDim PadBuffer(0 To V_PADSIZE - 1) As _Unsigned _Byte
            For I = 0 To (V_PADSIZE - 1): PadBuffer(I) = 0: Next
        End If
    End If

    If Interleave_Audio Then
        ' The blank first Audio param is used when parting out  the video
        ' To multiple files.  Each file must remain valid individually
        ' But we don't want to shift Audio alignment by a frame for every part !
        If BLANK_FIRST_AUDIO And (Audio_FrameSize < 2049) Then
            For I = 0 To UBound(AudioBuffer)
                AudioBuffer(I) = 0
            Next
        Else
            GetAudioFrame
        End If
        Put MainLFN, , AudioBuffer()

        ' If two Audio Frames are less/equal to the 4k size
        ' of the VERA PCM Fifo then we write two Audio Buffers directly
        ' after the Header.   The Player will prefill the FIFO on this condition
        ' No other header info is necessary, Decision is based on Audio Frame Size alone !
        If Audio_FrameSize < 2049 Then
            GetAudioFrame
            Put MainLFN, , AudioBuffer()
        End If
    End If

End Sub

Sub POST_PROCESS_PARTVIDEO
    Dim SRCPAL$
    Dim TrgPAL$
    Dim PPath$
    Dim SAudFile$
    Dim OutAudFile$
    Dim CMD$
    Dim PartHEADER As SVIDHeaderType
    Dim I As Long
    Dim J As Long
    Dim Fr_Count As _Unsigned Long

    _Dest _Console
    Print: Print
    PPath$ = GetFilePath(MovieName$) + GetFileName(MovieName$)
    If EXT_PALETTE_ON And (EXT_PALETTE_METHOD > 2) Then
        SRCPAL$ = " " + PPath$ + ".PAL"
        For I = 1 To NUMBER_OF_PARTS
            TrgPAL$ = " " + PPath$ + PartName(I) + ".PAL"
            CMD$ = CopyCmd$ + SRCPAL$ + TrgPAL$
            Print CMD$
            Shell CMD$
        Next
    End If

    If Not Interleave_Audio Then
        SAudFile$ = PPath$ + ".SVA"
        OpenAudioFile SAudFile$
        For I = 1 To NUMBER_OF_PARTS
            Open PPath$ + PartName(I) + ".SPV" For Binary As MainLFN
            Get MainLFN, , PartHEADER
            Close MainLFN
            Fr_Count = PartHEADER.NumFrames
            OutAudFile$ = PPath$ + PartName(I) + ".SVA"
            Print "WRITING: "; GetFileName(OutAudFile$) + ".SVA"
            Print
            If _FileExists(OutAudFile$) Then Kill OutAudFile$
            Open OutAudFile$ For Binary As 5
            For J = 1 To Fr_Count
                GetAudioFrame
                Put #5, , AudioBuffer()
            Next
            Close 5
        Next
        Close AudioLFN
        Kill SAudFile$
    End If
    MM_DestScr
End Sub

Function PartName$ (PNum As Integer)
    Dim TmpN$

    TmpN$ = "-PART-"
    If PNum < 10 Then TmpN$ = TmpN$ + "0"
    PartName$ = TmpN$ + _Trim$(Str$(PNum))

End Function

Sub PROCESS_THE_FRAMES (StartFrame As Long, EndFrame As Long)

    Dim I As Long
    Dim Y As Long
    Dim X As Long
    Dim Z As Long
    Dim SUFFIX$, DOFILE$

    $If CHECK_ERRORS = FALSE Then
        $Checking:Off
    $End If

    Select Case StartFrame
        Case 1 To 9
            SUFFIX$ = "0000000"
        Case 10 To 99
            SUFFIX$ = "000000"
        Case 100 To 999
            SUFFIX$ = "00000"
        Case 1000 To 9999
            SUFFIX$ = "0000"
        Case 10000 To 99999
            SUFFIX$ = "000"
        Case 100000 To 999999
            SUFFIX$ = "00"
        Case Is > 999999
            SUFFIX$ = "0"
    End Select

    CURRENT_PART_FRAME = 1

    ' FAST loading ONLY runs through the pipeline, using the MMFASTFRAME
    ' helper program (even with 1 thread).  There is no other way to do it.
    PIPE_FAST = _FALSE
    FAST_HELPER$ = ""
    If USE_QB64FASTMODE And (Not DO_JPG) And (Not CX16_IMG_MODE) Then
        FAST_HELPER$ = FAST_HELPER_PATH$
        If FAST_HELPER$ = "" Then
            ErrorHalt "FAST loading needs the helper program MMFASTFRAME" + CRLF + "in the same folder as this program." + CRLF + CRLF + "Looked in: " + MY_INSTALL_DIR$
        End If
        PIPE_FAST = _TRUE
    End If
    PIPE_ON = (Not DO_JPG) And ((MAGICK_PARALLEL > 1) Or PIPE_FAST)
    PIPE_FIRST = StartFrame
    PIPE_ANY_OK = _FALSE
    PIPE_NEXT = StartFrame
    PIPE_END = EndFrame
    ' the image pre-filter: inside the background jobs when the pipeline is on, else a pre-filter only pipeline
    PF_ON = RUN_PRE_FILTER And (Not PIPE_ON)
    PF_FIRST = StartFrame
    PF_NEXT = StartFrame
    PF_END = EndFrame

    I& = StartFrame
    Do
        'For I& = StartFrame To EndFrame
        If I& = 10 Then SUFFIX$ = "000000"
        If I& = 100 Then SUFFIX$ = "00000"
        If I& = 1000 Then SUFFIX$ = "0000"
        If I& = 10000 Then SUFFIX$ = "000"
        If I& = 100000 Then SUFFIX$ = "00"
        If I& = 1000000 Then SUFFIX$ = "0"


        MM_DestScr
        Percentage = (I& / FrameCount) * 100

        DOFILE$ = SUFFIX$ + Mid$(Str$(I&), 2) + FrameExt$

        If PF_ON Then PF_WAIT I&

        If DO_JPG Then
            WRITE_JPEG_FRAME DOFILE$
            GoTo NEXTFRAME
        End If

        PIPE_CUR = I&
        Load_Image DOFILE$


        If Bit_Map_Mode And X_BITS < 8 Then
            If X_BITS = 1 And X_PALMODE = CUST_1BPP Then
                UseCustom1BPP
            End If
            If X_BITS = 1 And X_PALMODE = BW_MODE Then
                ForceBW
            End If
            If X_PALMODE = GREEN_MODE Then InjectGreenPal: COUNT_IMAGE_COLORS
            If X_PALMODE = AMBER_MODE Then InjectAmberPal: COUNT_IMAGE_COLORS
        Else
            If Make4BPP_VIDEO And DoGreen Then InjectGreenPal: COUNT_IMAGE_COLORS
            If Make4BPP_VIDEO And DoAmber Then InjectAmberPal: COUNT_IMAGE_COLORS
        End If

        If EXT_PALETTE_ON Then
            IMAGEDATA_MAP_PALETTE
            COUNT_IMAGE_COLORS
        End If

        If VGA_16C And VGA16_BARS Then VGA16_ShiftUp

        If FOR_VGA Or VIDEO_IS_PREPADDED Or FOR_AMIGA GoTo SKIP_TALLSTUFF

        If Src_Aspect < 1 And Bit_Map_Mode _AndAlso (Not IS_DESKTOP_ONLY) Then
            If K_TYPE Then
                DO_TALL_RESIZE
            Else
                DO_TALL_PAD
            End If
        End If

        SKIP_TALLSTUFF:


        If Bit_Map_Mode Then
            WRITE_BitMap_Frame_AndPalette
            GoTo NEXTFRAME
        Else
            For Y = 0 To (ImageHeight - SprHeight) Step SprHeight
                For X = 0 To (ImageWidth - SprWidth) Step SprWidth
                    GetSprite X, Y
                    If Make4BPP_VIDEO Then
                        Make4bitSprite
                        Put MainLFN, , Sprite4BPP()
                    Else
                        Put MainLFN, , Sprite()
                    End If
                Next
            Next
        End If

        If Use_EMBEDDED_FramePalette Then
            If Make4BPP_VIDEO Then
                Grab4BitPalette
                If MAKE_SECTOR_VIDEO Then
                    PutFullSectorPalette
                Else
                    Put MainLFN, , VERAPAL4BPP()
                End If
            Else
                Put MainLFN, , VERAPAL()
            End If

        End If

        NEXTFRAME:
        If WantsPreview Then Showit Else MM_Progress
        If MM_SNAPREQ Then
            MM_SNAPREQ = _FALSE
            If WantsPreview Then SAVESAMPLEBIN I&, DOFILE$
        End If

        ' If Wipe_TMP_Files Then Kill DOFILE$
        CURRENT_PART_FRAME = CURRENT_PART_FRAME + 1

        If (I& < FrameCount) And Interleave_Audio Then
            If MAKE_SILENT_VIDEO Then
                Put MainLFN, , BlankAudioBuffer()
            Else
                GetAudioFrame
                Put MainLFN, , AudioBuffer()
            End If
        End If

        ExitSignal = 0
        If MM_CANCEL Then ExitSignal = 1: MM_CANCEL = _FALSE
        If ExitSignal > 0 Then
            MouseTick_ON
            If GotYES("CANCEL CONVERSION", "Cancel this conversion ?" + CRLF + CRLF + "The unfinished movie will be removed.", _FALSE) Then
                If PIPE_ON Then PIPE_CLEANUP
                PIPE_ON = _FALSE
                If PF_ON Then PF_CLEANUP
                ' Windows will not delete a file that is still open, so close the
                ' movie and audio files first (Kill gave error 75 on Windows).
                Close MainLFN
                Close AudioLFN
                Close 3
                ChDir ".."
                SAFE_KILL CURRENT_OUTSPV$
                Dim TMP_AF$
                TMP_AF$ = GetFilePath$(CURRENT_OUTSPV$) + GetFileName$(CURRENT_OUTSPV$) + ".SVA"
                SAFE_KILL TMP_AF$
                If Wipe_TMP_Files Then
                    If _DirExists("frames") Then
                        DIALOG_THEME.MSG_BG = _RGB32(125, 0, 0)
                        DIALOG_THEME.MSG_FG = _RGB32(50, 255, 0)
                        If GotYES("REMOVE FRAMES", "Remove the extracted Frames ?", _TRUE) Then
                            Shell NukeDir$ + "frames"
                            SAFE_KILL "audio.out"
                        End If
                        DIALOG_THEME.MSG_BG = _RGB32(0, 0, 110)
                        DIALOG_THEME.MSG_FG = _RGB32(255, 255, 255)
                        TMP_AF$ = BARE_CWD$
                        ChDir ".."
                        Shell _Hide "rmdir " + Chr$(34) + TMP_AF$ + Chr$(34) + " 2>" + NULL$
                    End If
                End If
                EXIT_MOVIEMAKER
            End If
            MouseTick_OFF
        End If

        'Next
        I& = I& + 1
    Loop Until I& > EndFrame
    If PIPE_ON Then PIPE_CLEANUP
    PIPE_ON = _FALSE
    If PF_ON Then PF_CLEANUP
    $If CHECK_ERRORS = FALSE Then
        $Checking:On
    $End If
End Sub

Sub GET_TOTALSIZE
    ' _Title "X16 Movie Maker - Starting Conversion"
    ' Dim Shared MOVIE_TOTAL_FRAMES As _Integer64
    ' Dim Shared SPV_TOTAL_SIZE As _Unsigned _Integer64
    ' Dim Shared CURRENT_SEGMENT_SIZE As _Unsigned Long
    ' Dim Shared FRAME_TOTAL_SIZE As _Unsigned _Integer64
    ' Dim Shared AUDIO_TOTAL_SIZE As _Unsigned _Integer64
    ' Dim Shared TOTAL_PALETTE_SIZE As _Unsigned Long
    Dim FrameSize As _Integer64
    Dim PSize As _Integer64
    Dim BitDiv As _Integer64

    If FOR_AMIGA Then
        FrameSize = (ImageWidth * ImageHeight) * (X_BITS / 8)
        Select Case X_BITS
            Case 4
                PSize = 32
            Case 3
                PSize = 16
            Case 2
                PSize = 8
            Case 1
                PSize = 4
        End Select
        FRAME_TOTAL_SIZE = FrameSize * FrameCount
        TOTAL_PALETTE_SIZE = PSize * FrameCount
        GoTo PCMSIZING
    End If

    If Bit_Map_Mode Then
        Select Case X_BITS
            Case 8
                BitDiv = 1
                PSize = 512
            Case 4
                BitDiv = 2
                PSize = 32
            Case 2
                BitDiv = 4
                PSize = 8
            Case 1
                BitDiv = 8
                PSize = 4
        End Select
    Else
        If Make4BPP_VIDEO Then
            BitDiv = 2
            PSize = 32
        Else
            BitDiv = 1
            PSize = 512
        End If
    End If

    If DO_JPG Then
        FRAME_TOTAL_SIZE = JPG_FRAMETOTALSIZE + (FrameCount * 4)
        TOTAL_PALETTE_SIZE = 0
        FrameSize = Int(FRAME_TOTAL_SIZE / FrameCount)
        GoTo PCMSIZING
    Else
        FrameSize = (ImageHeight * ImageWidth) \ BitDiv
        FRAME_TOTAL_SIZE = FrameSize * FrameCount
    End If


    If MAKE_SECTOR_VIDEO Then PSize = 512
    If FOR_VGA Or FULL_24BIT_PALETTE Then PSize = 768
    If VGA_16C Then PSize = 48
    TOTAL_PALETTE_SIZE = PSize * FrameCount

    PCMSIZING:
    If FOR_AMIGA Then
        PCM_BYTERATE = AMIGA_RATE
    Else
        PCM_BYTERATE = ((VERA_RATE / 128) * 48828.15)
    End If

    If ENABLE_16BIT_PCM Then PCM_BYTERATE = PCM_BYTERATE * 2
    If ENABLE_STEREO_PCM Then PCM_BYTERATE = PCM_BYTERATE * 2
    REAL_FPS = PCM_BYTERATE / Audio_FrameSize
    VIDEO_DATA_RATE = (FrameSize + PSize) * REAL_FPS
    AUDIO_DATA_RATE = Audio_FrameSize * REAL_FPS
    TOTAL_DATA_RATE = VIDEO_DATA_RATE + AUDIO_DATA_RATE

    If Interleave_Audio Then
        AUDIO_TOTAL_SIZE = Audio_FrameSize * FrameCount
        If Audio_FrameSize < 2049 Then
            AUDIO_TOTAL_SIZE = AUDIO_TOTAL_SIZE + Audio_FrameSize
        End If
    Else
        AUDIO_TOTAL_SIZE = 0
    End If

    SPV_TOTAL_SIZE = FRAME_TOTAL_SIZE + TOTAL_PALETTE_SIZE + AUDIO_TOTAL_SIZE

    If MAKE_SECTOR_VIDEO Then
        SPV_TOTAL_SIZE = SPV_TOTAL_SIZE + 512
    Else
        SPV_TOTAL_SIZE = SPV_TOTAL_SIZE + 32
    End If

    If SPV_TOTAL_SIZE < MAX_MOVIE_BYTES Then
        TARGET_PART_SIZE = SPV_TOTAL_SIZE
    Else
        Dim ms$

        TARGET_PART_SIZE = SPV_TOTAL_SIZE

        If MM_Chk(SplitCB) Then
            ASK_DO_PARTS
        Else
            ms$ = "This Movie File is too big for a FAT32 File System !" + CRLF + CRLF
            ms$ = ms$ + "YES    =  Split it into parts (the Split check box gets ticked)." + CRLF
            ms$ = ms$ + "NO     =  Make one big Desktop only file (not for a FAT32 SD-Card)." + CRLF
            ms$ = ms$ + "CANCEL =  Abort and start over with the same source file."
            MM_FATR = MessageBox(MM_Msg$(ms$), "File Size Warning !", MsgBox_YesNoCancel + MsgBox_Exclamation)
            Select Case MM_FATR
                Case MsgBox_Yes
                    MM_SetChk SplitCB, _TRUE
                    ASK_DO_PARTS
                Case MsgBox_No
                    ASK_DO_PARTS
                Case Else
                    ChDir ".."
                    If GotYES("REMOVE FRAMES", "Remove the extracted Frames ?", _TRUE) Then
                        Shell NukeDir$ + "frames"
                        If _FileExists("audio.out") Then Kill "audio.out"
                    End If
                    MM_RELAUNCH_FILE$ = MM_SRCFILE$
                    EXIT_MOVIEMAKER
            End Select
        End If
    End If
End Sub

Sub OPEN_TARGET_FOLDER
    Dim TF$
    Dim POPDIR$
    TF$ = TARGET_FOLDER$
    If (Left$(TF$, 1) <> Chr$(34)) And (InStr(TF$, Chr$(32)) > 0) Then
        TF$ = Chr$(34) + TF$ + Chr$(34)
    End If
    $If WINDOWS Then
        POPDIR$ = _CWD$
        ChDir TARGET_FOLDER$
        Shell _DontWait "START ."
        ChDir POPDIR$
    $Else
        Shell _DontWait SystemOpen$ + " " + TF$ + " > " + NULL$ + " 2>&1"
    $End If

End Sub

Sub WRITE_VideoPaletteFile
    Dim i As Long
    Dim PFILENAME$
    PFILENAME$ = TARGET_FOLDER$ + GetFileName(MovieName$) + ".PAL"
    If _FileExists(PFILENAME$) Then Kill PFILENAME$
    Open PFILENAME$ For Binary As #5
    If Make4BPP_VIDEO Then
        Dim VP As VPALTYPE
        For i = 0 To 15
            VP = VERA_LOADED_PALETTE(i)
            Put #5, , VP
        Next
    Else
        Put #5, , VERA_LOADED_PALETTE()
    End If
    Close #5
End Sub

Sub OPEN_SourceAudio
    Dim tmp$
    Dim MODCheck As Integer

    OpenAudioFile SRC_AUDIOFILE$

    If USE_EXISTING_FRAMEFOLDER Then
        If GET_FRAME_INFO Then
            MODCheck = Audio_FrameSize Mod 512
            If MAKE_SECTOR_VIDEO And (MODCheck > 0) Then
                If MODCheck < 32 Then
                    Audio_FrameSize = Audio_FrameSize - MODCheck
                    ReDim AudioBuffer(0 To Audio_FrameSize - 1) As _Unsigned _Byte
                    ReDim BlankAudioBuffer(0 To Audio_FrameSize - 1) As _Unsigned _Byte
                Else
                    GoTo GOT_PARMS
                End If
            End If
            tmp$ = "A Frames data File was Found !" + CRLF + "Using this DATA."
            MM_DestScr
            INFO_DIALOG "FOUND INFO FILE", (tmp$), "info"
            GoTo GOT_PARMS
        End If
        Dim AR
        AR = Audio_FrameSize * Val(MovieFPS$)
        If ENABLE_16BIT_PCM Or ENABLE_STEREO_PCM Then
            AR = AR / 2
        End If
        If ENABLE_16BIT_PCM And ENABLE_STEREO_PCM Then
            AR = AR / 2
        End If
        AR = _Round(AR)
        VERA_RATE = VERA_RATEBYTE(AR)
    End If

    GOT_PARMS:
    SUCCESS = _TRUE
    If MAKE_SECTOR_VIDEO And ((Audio_FrameSize Mod 512) > 0) Then
        MM_DestScr
        INFO_DIALOG "AUDIO FILE MISMATCH", SRC_AUDIOFILE$ + " Not suitable for High Bandwidth vid." + CRLF + "Not an even number of sector blocks !" + CRLF + CRLF + "Please Generate this Video from Scratch !", "info"
        SUCCESS = _FALSE
    End If
End Sub

Sub PutFullSectorPalette ()
    Static T_Pal_Indx As Integer
    Static L_Pal_Indx As Integer
    Dim I As Integer
    Static PalNum As Integer
    Static ZPal As VPALTYPE
    Static ZPal1 As VPALTYPE
    Static LastPal(0 To 15) As VPALTYPE

    If PalNum = 0 Then
        ZPal.GB = 0
        ZPal.R = 0
        PalNum = Val(UsedCols$) - 1
    End If

    If T_Pal_Indx = &HE0 Then
        T_Pal_Indx = &HF0 ' VERA Pal Row 15
        L_Pal_Indx = &HE0
    Else
        T_Pal_Indx = &HE0 ' VERA Pal Row 14
        L_Pal_Indx = &HF0
    End If
    If T_Pal_Indx = 0 Then T_Pal_Indx = &HE0

    $If CHECK_ERRORS = FALSE Then
        $Checking:Off
    $End If
    I = 0
    Do
        WorkingPAL(I + L_Pal_Indx) = LastPal(I)
        I = I + 1
    Loop Until I > PalNum
    I = 0
    If Bit_Map_Mode Then
        ZPal = VERAPALX_BPP(0)
        ZPal1 = VERAPALX_BPP(1)
        Do
            WorkingPAL(I + T_Pal_Indx) = VERAPALX_BPP(I)
            LastPal(I) = VERAPALX_BPP(I)
            I = I + 1
        Loop Until I > UBound(VERAPALX_BPP)
    Else
        ZPal = VERAPAL4BPP(0)
        Do
            WorkingPAL(I + T_Pal_Indx) = VERAPAL4BPP(I)
            LastPal(I) = VERAPAL4BPP(I)
            I = I + 1
        Loop Until I > PalNum
    End If
    WorkingPAL(0) = ZPal
    If X_BITS = 1 Then WorkingPAL(1) = ZPal1
    Put MainLFN, , WorkingPAL()
    $If CHECK_ERRORS = FALSE Then
        $Checking:On
    $End If
End Sub

Sub WRITE_BitMap_Frame_AndPalette
    ' Dim Shared FOR_VGA As Integer
    ' Dim Shared VGA_MODEX As Integer
    ' Dim Shared VGA_13H As Integer

    If FOR_AMIGA Then
        PutAmiga_PlanarBuffer
        PUT_AMIGAPALETTE
        Exit Sub
    End If

    If VGA_16C Then
        ' VGA 16 color (VTYPE 88, BPP 4): 4 bit planes written by the Amiga code, then 16 palette entries of 6 bit R,G,B
        VGA16_CheckPlanes
        PutAmiga_PlanarBuffer
        PUT_VGA16PALETTE
        Exit Sub
    End If

    If FOR_VGA Or FULL_24BIT_PALETTE Then
        If VGA_MODEX Then
            ' QUARTER THE ModeX BITMAP
            PutModeX_PlanarBuffer
        Else
            ' Contiguous 320 x 200 BITMAP
            Put MainLFN, , ImageData()
        End If
        Put MainLFN, , VGA_PALETTE()
        Exit Sub
    End If

    If X_BITS < 8 Then
        If Not CX16_IMG_MODE Then DownSampleImage
        Put MainLFN, , ImageDataX_BPP()
    Else
        Put MainLFN, , ImageData()
    End If

    PUTPALETTE:
    If MAKE_SECTOR_VIDEO Then
        If DoPadFrame Then Put MainLFN, , PadBuffer()
        If Use_EMBEDDED_FramePalette Then
            If X_BITS < 8 Then
                PutFullSectorPalette
            Else
                Put MainLFN, , VERAPAL()
            End If
        End If
    Else
        If Use_EMBEDDED_FramePalette Then
            If X_BITS < 8 Then
                Put MainLFN, , VERAPALX_BPP()
            Else
                Put MainLFN, , VERAPAL()
            End If
        End If
    End If
End Sub

Sub DO_TALL_RESIZE
    Static TImage1 As Long
    Static TImage2 As Long
    Static IMem1 As _MEM
    If TImage2 = 0 Then
        TImage2 = _NewImage(270, ImageHeight, 256)
        TImage1 = _NewImage(ImageWidth, ImageHeight, 256)
        IMem1 = _MemImage(TImage1)
    End If
    If USE_QB64FASTMODE Then
        MakeIndexZero_BLACK
    End If
    _MemPut IMem1, IMem1.OFFSET, ImageData()
    _PutImage , TImage1, TImage2
    _MemFill IMem1, IMem1.OFFSET, ImageWidth * ImageHeight, 0 As _Unsigned _Byte
    _PutImage (26, 0), TImage2, TImage1
    _MemGet IMem1, IMem1.OFFSET, ImageData()
End Sub

Sub DO_TALL_PAD
    Dim TImage1 As Long
    Dim TImage2 As Long
    Dim IMem1 As _MEM
    Dim X2 As Long
    Dim W2 As Long
    Dim DW As Double
    If USE_QB64FASTMODE Then
        MakeIndexZero_BLACK
    End If
    DW = ImageWidth
    W2 = Int(DW * .421875)
    X2 = (ImageWidth - W2) \ 2
    TImage1 = _NewImage(ImageWidth, ImageHeight, 256)
    TImage2 = _NewImage(W2, ImageHeight, 256)
    IMem1 = _MemImage(TImage1)
    _MemPut IMem1, IMem1.OFFSET, ImageData()
    _PutImage , TImage1, TImage2
    _MemFill IMem1, IMem1.OFFSET, ImageWidth * ImageHeight, 0 As _Unsigned _Byte
    _PutImage (X2, 0), TImage2, TImage1
    _MemGet IMem1, IMem1.OFFSET, ImageData()
    _MemFree IMem1
    _FreeImage TImage1
    _FreeImage TImage2
End Sub

Sub PAD_VIDEO_HEADER ()
    Dim I As Integer
    ReDim PadBuffer(0 To 479) As _Unsigned _Byte
    $If CHECK_ERRORS = FALSE Then
        $Checking:Off
    $End If
    For I = 0 To 479
        PadBuffer(I) = Asc("_")
    Next
    Put MainLFN, , PadBuffer()
    $If CHECK_ERRORS = FALSE Then
        $Checking:On
    $End If
End Sub

Sub KILL_TMP_MAPFILE
    Dim F$
    F$ = "cx16palexp.bmp"
    If _FileExists(F$) Then Kill F$
End Sub

Sub WriteX16Player ()
    Dim pfName$
    Dim b As _Unsigned _Byte
    Dim I As Integer
    Dim SeekPos As Long

    If FOR_VGA Then
        _WriteFile TARGET_FOLDER$ + "PLAYSPV.EXE", _Embedded$("DOSPLAYER")
        pfName$ = TARGET_FOLDER$ + UCase$(BASENAME$) + ".BAT"
        I = FreeFile
        Open pfName$ For Output As I
        pfName$ = UCase$(BASENAME$) + ".SPV"
        Print #I, "PLAYSPV " + pfName$
        Print #I, ""
        Close I
        Exit Sub
    End If

    ' Amiga (VTYPE 199): the Amiga player is written by the helper WRITE_AMPLAYER, if it is in this
    ' program's folder.  Run hidden, and skipped without a word when the helper is not there.
    If FOR_AMIGA Then
        If USE_AMIGA_PLAYER Then
            Dim ampSPV$
            ampSPV$ = CURRENT_OUTSPV$
            If InStr(ampSPV$, Chr$(34)) = 0 Then ampSPV$ = Chr$(34) + ampSPV$ + Chr$(34)
            Shell _Hide AMIGA_PLAYER_NAME$ + " " + ampSPV$
        End If
        Exit Sub
    End If
    If IS_DESKTOP_ONLY Then Exit Sub
    BASENAME$ = UCase$(BASENAME$)
    pfName$ = TARGET_FOLDER$ + BASENAME$ + ".PRG"
    ' Write the appropriate
    ' Commander X16
    ' binary PRG template.
    If DO_PART_VIDEO Then
        _WriteFile pfName$, _Embedded$("partplayer")
        ' This is the position in the X16 program file
        ' Where the filename variable value is located
        SeekPos = &HA5
    Else
        ' This is the position in the X16 program file
        ' Where the filename variable value is located
        SeekPos = &H2E
        _WriteFile pfName$, _Embedded$("x16player")
    End If
    ' Now seek and change the Video File Name
    ' variable in the Template
    Open pfName$ For Binary As #10
    Seek #10, SeekPos
    $If CHECK_ERRORS = FALSE Then
        $Checking:Off
    $End If

    For I = 1 To Len(BASENAME$)
        b = Asc(Mid$(BASENAME$, I, 1))
        Put #10, , b
    Next
    $If CHECK_ERRORS = FALSE Then
        $Checking:On
    $End If

    b = 0
    Put #10, , b
    Close 10
End Sub

Sub CheckVERAPal ()
    Dim TMPPAL As VPALTYPE
    DO_SWAP_1BPP = _FALSE
    Dim g0 As Integer
    Dim b0 As Integer
    Dim g1 As Integer
    Dim b1 As Integer
    Dim Level0 As Integer
    Dim Level1 As Integer

    g0 = Int(VERAPAL(0).GB / 16)
    b0 = VERAPAL(0).GB And &H0F
    Level0 = g0 + b0 + VERAPAL(0).R

    g1 = Int(VERAPAL(1).GB / 16)
    b1 = VERAPAL(1).GB And &H0F
    Level1 = g1 + b1 + VERAPAL(1).R

    If Level0 > Level1 Then
        TMPPAL = VERAPAL(0)
        VERAPAL(0) = VERAPAL(1)
        VERAPAL(1) = TMPPAL
        DO_SWAP_1BPP = _TRUE
    End If
End Sub

Sub GET_SRC_IMAGESIZE (SourceImageName$)
    Dim chkheader As BMPHeaderType
    Dim cmd$, tmp$
    Dim TEM_PATH$
    Dim POPD$
    Dim OUTFILE$
    Src_Width = 0
    Src_Height = 0
    SUCCESS = _FALSE

    If _FileExists(SourceImageName$) Then
        TEM_PATH$ = GetFilePath(SourceImageName$)
        POPD$ = _CWD$
        If (TEM_PATH$ <> "") _AndAlso (TEM_PATH$ <> POPD$) Then
            ChDir TEM_PATH$
        End If
        tmp$ = GetFileName(SourceImageName$) + GetFileExt(SourceImageName$)
        If InStr(tmp$, Chr$(32)) > 0 Then
            tmp$ = Chr$(34) + tmp$ + Chr$(34)
        End If
        OUTFILE$ = MAKE_UNIQUE_TMP(".bmp")
        cmd$ = Magick$ + " " + tmp$ + " " + OUTFILE$
        Shell cmd$
        If _FileExists(OUTFILE$) Then
            Open OUTFILE$ For Binary As #1
            Get #1, , chkheader
            Close #1
            Src_Width = chkheader.wid
            Src_Height = chkheader.hei
            Src_Aspect = Src_Width / Src_Height
            Kill OUTFILE$
            SUCCESS = _TRUE
        Else
            _Dest _Console
            Print
            Print "MAGICK COMMAND FAILED"
            Print
            MM_DestScr
        End If
        ChDir POPD$
    End If
End Sub

Function MAKE_UNIQUE_TMP$ (EXT$)
    Dim TMP$
    Dim FLIP As Integer
    Dim I As Integer
    Dim C As _Unsigned _Byte
    Randomize Timer

    STARTRAND:
    TMP$ = ""
    For I = 1 To 10
        FLIP = Int(Rnd(1) * 30) + 1
        If FLIP < 11 Then
            C = Int(Rnd(1) * 10) + 48
        End If
        If FLIP > 10 And FLIP < 21 Then
            C = Int(Rnd(1) * 26) + 97
        End If
        If FLIP > 20 Then
            C = Int(Rnd(1) * 26) + 65
        End If
        TMP$ = TMP$ + Chr$(C)
    Next
    TMP$ = TMP$ + EXT$
    If _FileExists(TMP$) Then GoTo STARTRAND
    MAKE_UNIQUE_TMP$ = TMP$
End Function

Sub MAKE_BLANK_AUDIOFILE (AFileName$, NumberofBytes As _Unsigned Long)
    Dim Bytes_Written As _Unsigned Long
    Dim OUTBUFFER(0 To 65535) As _Unsigned _Byte
    Dim W As _Unsigned Integer

    If _FileExists(AFileName$) Then Kill AFileName$
    Open AFileName$ For Binary As #17

    While (NumberofBytes - Bytes_Written) > Len(OUTBUFFER())
        Put #17, , OUTBUFFER()
        Bytes_Written = Bytes_Written + Len(OUTBUFFER())
    Wend

    While Bytes_Written < NumberofBytes
        Put #17, , W
        Bytes_Written = Bytes_Written + 2
    Wend
    Close 17
End Sub

Sub OpenAudioFile (AFileName$)
    Dim DoAdjust As Integer
    Dim ModCheck As Integer
    Dim Test1
    Dim Test2
    Dim Adjust As Integer
    Dim FSize As Long

    DoAdjust = _FALSE
    If ENABLE_16BIT_PCM Or ENABLE_STEREO_PCM Then
        DoAdjust = _TRUE
        ModCheck = 2
    End If
    If ENABLE_16BIT_PCM And ENABLE_STEREO_PCM Then
        ModCheck = 4
    End If
    START_AUDIO_OPEN:
    If MAKE_SILENT_VIDEO Then
        Audio_FrameSize = aframe
        GoTo DONE_AUD:
    End If

    If _FileExists(AFileName$) Then
        Open AFileName$ For Binary As AudioLFN
        AudioFileSize = LOF(AudioLFN)
        AudioByteCount = AudioFileSize

        If MAKE_SECTOR_VIDEO Then
            Audio_FrameSize = aframe
        Else
            Test1 = AudioFileSize / FrameCount
            Test2 = _Round(Test1)
            FSize = Test2
            If DoAdjust Then
                If Test2 < Test1 Then Adjust = 1
                If Test2 > Test1 Then Adjust = -1
                If Adjust = 0 Then Adjust = 1
                If Test2 Mod ModCheck > 0 Then
                    Do While (FSize Mod ModCheck) > 0
                        FSize = FSize + Adjust
                    Loop
                End If
            End If
            Audio_FrameSize = FSize
        End If
    Else
        _SndPlay ERROR_BEEP
        MAKE_SILENT_VIDEO = GotYES("AUDIO FILE ERROR", AFileName$ + " NOT FOUND !" + CRLF + CRLF + "Make a Silent Video ?", _TRUE)
        If MAKE_SILENT_VIDEO GoTo START_AUDIO_OPEN
        EXIT_MOVIEMAKER
    End If
    DONE_AUD:
    AudIndxLimit = Audio_FrameSize - 1
    ReDim AudioBuffer(0 To AudIndxLimit)
    ReDim BlankAudioBuffer(0 To AudIndxLimit)

End Sub

Sub ZeroAudioBuffer
    Dim I As Long
    $If CHECK_ERRORS = FALSE Then
        $Checking:Off
    $End If

    For I = 0 To AudIndxLimit
        AudioBuffer(I) = 0
    Next
    $If CHECK_ERRORS = FALSE Then
        $Checking:On
    $End If

End Sub

Sub GetAudioFrame
    Static NoMoreAudio

    If NoMoreAudio Then Exit Sub
    If AudioByteCount >= Audio_FrameSize Then
        Get AudioLFN, , AudioBuffer()
        AudioByteCount = AudioByteCount - Audio_FrameSize
    Else
        ZeroAudioBuffer
        If AudioByteCount > 0 Then
            Get AudioLFN, , AudioBuffer()
            AudioByteCount = 0
        Else
            NoMoreAudio = _TRUE
            Close AudioLFN
        End If
    End If
End Sub

Sub ShowAudioInterleave
    Color _RGB(255, 195, 0)
    Print " TOGGLE Audio Track: ";
    If Interleave_Audio Then
        Color _RGB(255, 255, 255), _RGB(250, 0, 0)
        Print " Embedded ";
    Else
        Color _RGB(155, 155, 155), _RGB(250, 0, 0)
        Tprint "{WHT}.SVA {GRAY 1}file "
    End If
    Color _RGB(155, 155, 155), _RGB(0, 0, 180)
End Sub

Sub ShowAudioFormat
    Color _RGB(155, 155, 155), _RGB(0, 0, 180)
    Print "Audio Format:   ";
    If AUDIO_EXTENTIONS_ON Then
        Color _RGB(255, 255, 255), _RGB(250, 0, 0)
    Else
        Color _RGB(155, 155, 155), _RGB(250, 0, 0)
    End If

    If ENABLE_16BIT_PCM Then
        Print " 16 bit";
    Else
        Print "  8 bit";
    End If

    If ENABLE_STEREO_PCM Then
        Print " stereo";
    Else
        Print " mono  ";
    End If
    Color _RGB(255, 255, 255), _RGB(0, 0, 180)
End Sub

