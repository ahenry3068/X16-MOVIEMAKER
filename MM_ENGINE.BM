End Sub

Function Video_IS_NORMAL%
    Video_IS_NORMAL = (Src_Aspect >= 1.2) _AndAlso (Src_Aspect < 1.5)
End Function

Sub ErrorHalt (msg$)
    INFO_DIALOG "Movie Maker Error", msg$, "error"
    System
End Sub

Sub CREATE_PALETTE_BMP (BF_NAME$, NORMAL_PALETTE As Integer)
    If GetFileExt(BF_NAME$) = "" Then
        BF_NAME$ = BF_NAME$ + ".BMP"
    End If

    Dim PALHEADER As BMPHeaderType
    Dim I As Long
    Dim R As _Unsigned _Byte
    Dim G As _Unsigned _Byte
    Dim B As _Unsigned _Byte
    Dim Pixel As _Unsigned _Byte
    Dim PixBase As _Unsigned _Byte
    Dim Y As Integer
    Dim X As Integer
    Dim C As Long
    Dim LINES As Integer
    Dim tmp$
    Dim P_LFN As Long

    PALHEADER.id = "BM"
    PALHEADER.rr1 = 0
    PALHEADER.rr2 = 0
    PALHEADER.wid = 320
    PALHEADER.hei = 320
    PALHEADER.horz = 40
    PALHEADER.size = (320 * 320) + Len(PALHEADER)
    PALHEADER.imagebytes = 320 * 320
    PALHEADER.offset = Len(PALHEADER)
    PALHEADER.planes = 1
    PALHEADER.bpp = 8
    PALHEADER.pakbyte = 0
    PALHEADER.xres = 2835
    PALHEADER.yres = 2835
    PALHEADER.colch = 256
    PALHEADER.ic = 256

    tmp$ = ""
    $If CHECK_ERRORS = FALSE Then
        $Checking:Off
    $End If
    If NORMAL_PALETTE Then
        For I = 0 To 255
            G = _Green32(ImagePalette(I))
            B = _Blue32(ImagePalette(I))
            R = _Red32(ImagePalette(I))
            tmp$ = tmp$ + Chr$(B) + Chr$(G) + Chr$(R) + Chr$(255)
        Next
    Else
        For I = 0 To EXT_UPPER_COLOR
            G = _Green32(TARGET_PAL_FOR_MAPPING(I))
            B = _Blue32(TARGET_PAL_FOR_MAPPING(I))
            R = _Red32(TARGET_PAL_FOR_MAPPING(I))
            tmp$ = tmp$ + Chr$(B) + Chr$(G) + Chr$(R) + Chr$(255)
        Next
    End If

    If EXT_UPPER_COLOR < 255 Then
        For I = EXT_UPPER_COLOR + 1 To 255
            G = _Green32(VERA_DEFAULT_PALETTE_EXPANDED(I))
            B = _Blue32(VERA_DEFAULT_PALETTE_EXPANDED(I))
            R = _Red32(VERA_DEFAULT_PALETTE_EXPANDED(I))
            tmp$ = tmp$ + Chr$(B) + Chr$(G) + Chr$(R) + Chr$(255)
        Next
    End If

    PALHEADER.pal = tmp$
    $If CHECK_ERRORS = FALSE Then
        $Checking:On
    $End If

    If _FileExists(BF_NAME$) Then Kill BF_NAME$

    P_LFN = FreeFile
    Open BF_NAME$ For Binary As P_LFN

    Put P_LFN, , PALHEADER

    PixBase = &HF0
    For Y = 0 To 15
        For LINES = 0 To 19
            For X = 0 To 15
                Pixel = PixBase + X
                For C = 0 To 19
                    Put P_LFN, , Pixel
                Next
            Next
        Next
        PixBase = PixBase - 16
    Next
    Close P_LFN
End Sub

Sub CREATE_AVERAGED_PALETTE
    Dim SAMPLENUMS(0 To 29) As Long
    Dim SAMPLEFILES$(0 To 29)
    Dim suffix$
    Dim CMD$
    Dim ALLDONE As Integer
    Dim I As Long
    Dim J As Long
    Dim rAdder As Long
    Dim rMult As Long
    I = 0
    ALLDONE = _FALSE
    MM_DestScr
    Color _RGB(255, 255, 255), _RGB(0, 0, 180)
    Cls
    Print
    Tprint "  {GRAY 1} Starting Palette Averaging{LIGHT RED}.......{13}{13}"

    rMult = FrameCount * (1 / 3)
    rAdder = 1
    Do
        GET_ANOTHER_NUMBER:
        SAMPLENUMS(I) = Int(Rnd(1) * rMult) + rAdder
        If I > 1 Then
            For J = 1 To I - 1
                If SAMPLENUMS(I) = SAMPLENUMS(J) GoTo GET_ANOTHER_NUMBER
            Next
        End If
        I = I + 1
        If I = 4 Then
            rAdder = rMult
        End If
        If I = 9 Then
            rAdder = (rAdder + rMult) - 1
        End If
        ALLDONE = (I > 14)
    Loop Until ALLDONE
    Print
    For I = 0 To 14
        If SAMPLENUMS(I) < 10 Then
            suffix$ = "0000000"
            GoTo MAKESAMPLENAME
        End If
        If SAMPLENUMS(I) > 9 _AndAlso SAMPLENUMS(I) < 100 Then
            suffix$ = "000000"
            GoTo MAKESAMPLENAME
        End If
        If SAMPLENUMS(I) > 99 _AndAlso SAMPLENUMS(I) < 1000 Then
            suffix$ = "00000"
            GoTo MAKESAMPLENAME
        End If
        If SAMPLENUMS(I) > 999 _AndAlso SAMPLENUMS(I) < 10000 Then
            suffix$ = "0000"
            GoTo MAKESAMPLENAME
        End If
        If SAMPLENUMS(I) > 9999 _AndAlso SAMPLENUMS(I) < 100000 Then
            suffix$ = "000"
            GoTo MAKESAMPLENAME
        End If
        If SAMPLENUMS(I) > 99999 Then suffix$ = "00"
        MAKESAMPLENAME:
        SAMPLEFILES$(I) = suffix$ + Mid$(Str$(SAMPLENUMS(I)), 2) + FrameExt$
        Tprint "{WHT} USING{GRN}: {LIGHT RED}" + SAMPLEFILES$(I) + "{13}"
    Next
    Print
    CMD$ = Magick$

    For I = 0 To 14
        CMD$ = CMD$ + Chr$(32) + SAMPLEFILES$(I)
    Next

    If _FileExists("outcolor.bmp") Then Kill "outcolor.bmp"

    CMD$ = CMD$ + " +append -colors " + UsedCols$ + " -type palette BMP3:outcolor.bmp"

    Tprint " {WHT}EXECUTING{GRN}: {LIGHT GREEN}"
    Print CMD$
    Print
    Shell CMD$
End Sub

Sub KILL_EXTRACTION
    ' Stops a running ffmpeg without needing its process id.
    $If WINDOWS Then
        Shell _Hide "taskkill /F /IM ffmpeg.exe >nul 2>&1"
    $Else
        Shell _Hide "killall ffmpeg >/dev/null 2>&1 || pkill ffmpeg >/dev/null 2>&1"
    $End If
End Sub

Sub EXTRACT_CANCEL_CHECK (SubTitle$)
    ' Called from the ffmpeg wait loops: honors the Cancel button while frames
    ' or audio are being extracted.
    Dim TMP_AF$
    Dim SavedDest As Long, SavedSource As Long
    If Not MM_CANCEL Then Exit Sub
    MM_CANCEL = _FALSE
    ' the dialog runs the form's event loop, which leaves _Dest/_Source pointing
    ' elsewhere: remember them so the ffmpeg screen keeps updating after "No"
    SavedDest = _Dest
    SavedSource = _Source
    If Not GotYES("CANCEL CONVERSION", "Cancel this conversion ?" + CRLF + CRLF + "ffmpeg will be stopped.", _FALSE) Then
        _Dest SavedDest
        _Source SavedSource
        MM_Show
        Exit Sub
    End If
    _Dest SavedDest
    _Source SavedSource
    KILL_EXTRACTION
    MM_Delay 1
    SAFE_KILL "ffmpeg-out.dat"
    SAFE_KILL "audio.out"
    SAFE_KILL ".." + Slash$ + "audio.out"
    If Wipe_TMP_Files Then
        If _DirExists("frames") Then
            DIALOG_THEME.MSG_BG = _RGB32(125, 0, 0)
            DIALOG_THEME.MSG_FG = _RGB32(50, 255, 0)
            If GotYES("REMOVE FRAMES", "Remove the extracted Frames ?", _TRUE) Then
                Shell NukeDir$ + "frames"
                TMP_AF$ = BARE_CWD$
                DIALOG_THEME.MSG_BG = _RGB32(0, 0, 110)
                DIALOG_THEME.MSG_FG = _RGB32(255, 255, 255)
                ChDir ".."
                Shell _Hide "rmdir " + Chr$(34) + TMP_AF$ + Chr$(34) + " 2>" + NULL$
            Else
                DIALOG_THEME.MSG_BG = _RGB32(0, 0, 110)
                DIALOG_THEME.MSG_FG = _RGB32(255, 255, 255)
            End If
        End If
    End If
    EXIT_MOVIEMAKER
End Sub

Sub RUN_FFMPEG (FCmd$, SubTitle$, HALT_ON_ERROR As Integer)
    Dim PrevFFSCR As Integer
    Dim SAVE_SCREEN As Long
    Dim frame$
    Dim progress$
    Dim speed$
    Dim fps$
    Dim vidtime$
    Dim YLoc As Integer
    Dim YAfter As Integer

    Dim Cm1$
    Dim Cm2$
    Dim Cm3$
    Dim Cm4$
    Dim QuoteOpen As Integer
    Dim GotName As Integer

    Dim LASTPOS As _Unsigned Long
    Dim DotString$
    Dim Col$
    Dim DCol As Integer
    Dim INS$
    Dim L As Integer
    Dim L2 As Integer
    Dim I As Integer
    Dim LCOUNT As _Unsigned _Integer64
    FFMPEG_ERROR = _FALSE
    MM_IN_FFMPEG = _TRUE
    SAVE_SCREEN = _CopyImage(MM_SCR)
    PrevFFSCR = MM_FFSCR
    MM_FFSCR = _TRUE
    PROG_HEADER "X16 Movie Maker - Running FFMPEG"
    If _FileExists("ffmpeg-out.dat") Then Kill "ffmpeg-out.dat"
    $If WINDOWS Then
        Shell _DontWait _Hide FCmd$ + " -progress ffmpeg-out.dat"
    $Else
        Shell _DontWait FCmd$ + " -progress ffmpeg-out.dat"
    $End If
    I = 1
    Do
        Cm2$ = Cm3$
        Cm3$ = Mid$(FCmd$, I, 1)
        I = I + 1
    Loop Until Cm3$ = "i" And Cm2$ = "-"

    Cm2$ = Mid$(FCmd$, I)
    Cm2$ = _Trim$(Cm2$)

    QuoteOpen = (Asc(Cm2$) = 34)

    L = Len(Cm2$)

    Cm4$ = ""
    Do
        Cm3$ = Mid$(Cm2$, L, 1)
        If Asc(Cm3$) <> 32 Then Cm4$ = Cm3$ + Cm4$
        L = L - 1
    Loop Until Cm3$ = Chr$(32)
    L = Len(Cm2$)
    L2 = Len(Cm4$)
    Cm2$ = _Trim$(Left$(Cm2$, L - L2))
    I = 1
    GotName = _FALSE
    Cm1$ = ""
    Do
        Cm3$ = Mid$(Cm2$, I, 1)
        If (Asc(Cm3$) <> 32) Or QuoteOpen Then Cm1$ = Cm1$ + Cm3$
        If QuoteOpen Then
            GotName = ((I > 1) And (Asc(Cm3$) = 34))
        Else
            GotName = ((I > 1) And (Asc(Cm3$) = 32))
        End If
        I = I + 1
    Loop Until GotName
    L = Len(Cm2$)
    L2 = Len(Cm1$)
    Cm2$ = _Trim$(Right$(Cm2$, L - L2))

    DotString$ = "."
    Col$ = "{LIGHT RED}"
    Do
        Locate 9, 10
        DCol = DCol + 1
        If DCol > 15 Then DCol = 0
        Col$ = "{" + CString(DCol) + "}"
        Tprint " {WHT}Waiting" + Col$ + DotString$ + "          "
        DotString$ = DotString$ + "."
        If DotString$ = "......." Then
            DotString$ = "."
        End If
        MM_Show
        EXTRACT_CANCEL_CHECK SubTitle$
        _Limit 20
    Loop Until _FileExists("ffmpeg-out.dat")
    Locate 9, 4
    Tprint "{YEL}ffmpeg {WHT}-i {LIGHT GREEN}" + Cm1$ + " {GRN}" + Cm2$ + " {LIGHT RED}" + Cm4$
    YAfter = CsrLin + 2
    ' Tprint "{CYAN}" + FCmd$

    DotString$ = "."
    Do
        LCOUNT = LCOUNT + 1
        Locate YAfter, 12
        Tprint "  {YEL}" + SubTitle$ + "{LIGHT GREEN}  Check status pass{GRN}: {YEL}#{WHT}" + _Trim$(Str$(LCOUNT))
        Open "ffmpeg-out.dat" For Input As 9
        If LCOUNT > 100 And LOF(9) = 0 Then
            Close 9
            If _FileExists("ffmpeg-out.dat") Then Kill "ffmpeg-out.dat"
            If HALT_ON_ERROR Then
                INFO_DIALOG "FFMPEG ERROR", "FFMPEG ENCOUNTERED AN ERROR EXECUTING:" + CRLF + CRLF + FCmd$, "ERROR"
                EXIT_MOVIEMAKER
            Else
                If GotYES("FFMEG ERROR", "ERROR EXECUTING" + CRLF + CRLF + FCmd$ + CRLF + CRLF + "Continue ?", _TRUE) Then
                    FFMPEG_ERROR = _TRUE
                    MM_FFSCR = PrevFFSCR
                    MM_IN_FFMPEG = _FALSE
                    Exit Sub
                Else
                    EXIT_MOVIEMAKER
                End If
            End If
        End If
        If LOF(9) > 0 Then
            Seek 9, LASTPOS + 1
            Do
                GoSub GETNEXTLINE
            Loop Until EOF(9)
            LASTPOS = Loc(9)
        End If
        Close 9
        GoSub PRINT_FSTATUS
        MM_Show
        EXTRACT_CANCEL_CHECK SubTitle$
        _Limit 30
    Loop Until progress$ = "end"

    Locate 25, 42
    Tprint "{LIGHT GREEN} DONE{WHT}......{LIGHT RED}!!"
    MM_Delay 2.5
    If _FileExists("ffmpeg-out.dat") Then Kill "ffmpeg-out.dat"
    _PutImage , SAVE_SCREEN, MY_DISPLAY
    _FreeImage SAVE_SCREEN
    MM_FFSCR = PrevFFSCR
    MM_IN_FFMPEG = _FALSE
    Exit Sub

    GETNEXTLINE:
    Line Input #9, INS$
    PARSE_INFO INS$
    Select Case LEFT_PARSE$
        Case "progress"
            progress$ = RIGHT_PARSE$
        Case "frame"
            frame$ = RIGHT_PARSE$
        Case "speed"
            speed$ = RIGHT_PARSE$
        Case "fps"
            fps$ = RIGHT_PARSE$
        Case "out_time"
            vidtime$ = RIGHT_PARSE$
        Case Else
            ' Nothing
    End Select
    Return

    PRINT_FSTATUS:
    YLoc = YAfter + 2
    If Len(frame$) > 0 Then
        Locate YLoc, 58
        Tprint "{WHT} Frame{RED}: {LIGHT GREEN}" + frame$
        YLoc = YLoc + 2
    End If

    If Len(vidtime$) > 0 Then
        Locate YLoc, 58
        Tprint "{WHT}  Time{RED}: {LIGHT GREEN}" + vidtime$ + "     "
        YLoc = YLoc + 2
    End If

    If Len(speed$) > 0 Then
        Locate YLoc, 58
        Tprint "{WHT} Speed{RED}: {LIGHT GREEN}" + speed$ + "     "
        YLoc = YLoc + 2
    End If

    If Len(fps$) > 0 Then
        Locate YLoc, 58
        Tprint "{WHT}   FPS{RED}: {LIGHT GREEN}" + fps$ + "      "
    End If

    If Len(progress$) > 0 Then
        Locate 25, 45
        Tprint "{WHT}Working{RED}:" + Col$ + DotString$ + "          "
        DotString$ = DotString$ + "."
        If DotString$ = "........" Then
            DotString$ = "."
            If Col$ = "{LIGHT RED}" Then
                Col$ = "{LIGHT GREEN}"
            Else
                Col$ = "{LIGHT RED}"
            End If
        End If
    End If
    Return
End Sub

Sub PARSE_INFO (PARSTR$)
    Dim L As Long
    Dim MP As Integer
    Dim TMP$
    TMP$ = _Trim$(PARSTR$)
    L = Len(TMP$)
    MP = InStr(TMP$, "=")
    If MP = 0 Then
        LEFT_PARSE$ = TMP$
        RIGHT_PARSE$ = ""
    Else
        LEFT_PARSE$ = Left$(TMP$, MP - 1)
        RIGHT_PARSE$ = Right$(TMP$, L - MP)
    End If
End Sub

Sub CHOOSE_A_VIDEOFILE
    Dim VExtensions$
    VExtensions$ = "*.mpg|*.MPG|*.mpeg|*.MPEG|*.MP4|*.mp4|*.mkv|*.MKV|*.avi|*.AVI|*.mov|*.MOV|*.M4V|*.m4v|*.webm|*.WEBM"
    TName$ = _OpenFileDialog$("X16 Movie Maker - Select Video File to Convert", "", VExtensions$, "Movie Files", 0)
    If TName$ = "" Then Exit Sub
    SUCCESS = _TRUE
    VIDEO_IS_PICKED = _TRUE
    NEW_VIDEO_PROJECT = _TRUE
    USE_EXISTING_FRAMEFOLDER = _FALSE
    GetSource_Parameters (TName$)
    DName$ = TName$
End Sub

Function GET_FRAME_INFO%
    Dim tmp$
    Dim i As Long
    Dim PCOUNT As Integer
    PCOUNT = 0
    If _FileExists("frames.data") Then
        Open "frames.data" For Input As 17
        For i = 1 To 3
            Line Input #17, tmp$
            PARSE_INFO tmp$
            Select Case LEFT_PARSE$
                Case "FPS"
                    MovieFPS$ = _Trim$(RIGHT_PARSE$)
                    PCOUNT = PCOUNT + 1
                Case "VBYTE"
                    VERA_RATE = Val(_Trim$(RIGHT_PARSE$))
                    PCOUNT = PCOUNT + 1
                Case "AFRAME"
                    Audio_FrameSize = Val(_Trim$(RIGHT_PARSE$))
                    PCOUNT = PCOUNT + 1
            End Select
        Next
        Close 17
    End If
    SUCCESS = (PCOUNT = 3)
    GET_FRAME_INFO = SUCCESS
End Function

Function GET_FILESIZE&& (TFile$)
    Dim tmp As _Unsigned _Integer64
    If Not _FileExists(TFile$) Then
        tmp = 0
    Else
        Open TFile$ For Binary As #21
        tmp = LOF(21)
        Close 21
    End If
    GET_FILESIZE = tmp
End Function

Sub SwapPaletteColors (UsedIndx As Integer, FreeIndx As Integer)
    Static VPalTmp As VPALTYPE
    Static PalL As Long
    Static TmpVGA As VGAPAL_TYPE
    Dim I As Long

    ' Save the Used Indice Palette Color
    VPalTmp = VERAPAL(UsedIndx) ' Image 12 bit VERA Palette
    PalL = ImagePalette(UsedIndx) ' Preview Image 32 bit translated palette color
    If FOR_VGA Or FULL_24BIT_PALETTE Then
        TmpVGA = VGA_PALETTE(UsedIndx)
    End If

    ' Free the Used Index and copy the VERA Default Value to it.
    VERAPAL(UsedIndx) = VERAPALDEFAULT(UsedIndx)
    ImagePalette(UsedIndx) = VERA_DEFAULT_PALETTE_EXPANDED(UsedIndx)

    If FOR_VGA Or FULL_24BIT_PALETTE Then
        VGA_PALETTE(UsedIndx) = VGA_PALETTE(FreeIndx)
        VGA_PALETTE(FreeIndx) = TmpVGA
    End If

    VERAPAL(FreeIndx) = VPalTmp
    ImagePalette(FreeIndx) = PalL
    COLOR_IS_USED(FreeIndx) = _TRUE
    COLOR_IS_USED(UsedIndx) = _FALSE

    ' Remember the Used -> Free index change.  The pixels are rewritten in
    ' ONE pass by SHIFT_THE_PALETTE once all of the swaps are known.
    If Not SWAP_PENDING Then
        For I = 0 To 255
            SWAP_REMAP(I) = I
        Next
        SWAP_PENDING = _TRUE
    End If
    SWAP_REMAP(UsedIndx) = FreeIndx
End Sub

Sub SWAPIN_IMMORTAL_PALETTE
    Dim I As Long
    Restore IMMORTAL_PALETTE
    For I = 0 To 255
        Read VERAPALDEFAULT(I).GB
        Read VERAPALDEFAULT(I).R
        VERA_DEFAULT_PALETTE_EXPANDED(I) = VERA2RGB(VERAPALDEFAULT(I))
        WorkingPAL(I) = VERAPALDEFAULT(I)
    Next
End Sub

Sub LOAD_VERA_DEFAULTPALETTES
    Dim I As Long
    Restore VERA_DEFAULT
    For I = 0 To 255
        Read VERAPALDEFAULT(I).GB
        Read VERAPALDEFAULT(I).R
        VERA_DEFAULT_PALETTE_EXPANDED(I) = VERA2RGB(VERAPALDEFAULT(I))
        WorkingPAL(I) = VERAPALDEFAULT(I)
    Next

    Restore VERA_GRAY
    For I = 0 To 15
        Read VERA_DEF_GRAY(I).GB
        Read VERA_DEF_GRAY(I).R
    Next
End Sub

Function HighestPalFree%
    Dim I As Integer
    Dim R As Integer
    Dim GOTIT As Integer
    I = 255
    Do
        If Not COLOR_IS_USED(I) Then
            GOTIT = _TRUE
            R = I
            Exit Do
        End If
        I = I - 1
    Loop Until I < 0
    If GOTIT Then
        HighestPalFree = R
    Else
        HighestPalFree = -2
    End If
End Function

Function BARE_CWD$
    Dim temp$, temp2$
    Dim I As Long
    temp$ = _CWD$
    I = Len(temp$)
    If Mid$(temp$, I, 1) = "/" Or Mid$(temp$, I, 1) = "\" Then I = I - 1
    Do
        If I = 0 Then Exit Do
        temp2$ = Mid$(temp$, I, 1) + temp2$
        I = I - 1
        If I = 0 Then Exit Do
    Loop Until (Mid$(temp$, I, 1) = "/" Or Mid$(temp$, I, 1) = "\")
    BARE_CWD = temp2$
End Function

